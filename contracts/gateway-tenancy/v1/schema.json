{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lobehub:gateway-tenancy:1",
  "title": "Gateway tenancy protocol 1 wire DTOs",
  "$defs": {
    "principal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user",
            "workspace"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "jwtHeader": {
      "type": "object",
      "properties": {
        "alg": {
          "const": "RS256"
        },
        "kid": {
          "type": "string",
          "minLength": 1
        },
        "typ": {
          "const": "JWT"
        }
      },
      "required": [
        "alg",
        "kid"
      ],
      "additionalProperties": false
    },
    "tokenClaims": {
      "type": "object",
      "properties": {
        "iss": {
          "const": "urn:lobehub:gateway-session"
        },
        "aud": {
          "type": "string",
          "enum": [
            "urn:lobehub:gateway:agent",
            "urn:lobehub:gateway:device"
          ]
        },
        "purpose": {
          "const": "gateway-connect"
        },
        "tid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "sub": {
          "type": "string",
          "minLength": 1
        },
        "principal": {
          "$ref": "#/$defs/principal"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "agent:observe",
              "agent:respond",
              "agent:execute",
              "device:connect",
              "device:respond"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "authorization_id": {
          "type": "string",
          "minLength": 1
        },
        "accepted_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "jti": {
          "type": "string",
          "minLength": 1
        },
        "iat": {
          "type": "number"
        },
        "exp": {
          "type": "number"
        },
        "nbf": {
          "type": "number"
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "connection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "iss",
        "aud",
        "purpose",
        "tid",
        "sub",
        "principal",
        "capabilities",
        "authorization_id",
        "accepted_version",
        "jti",
        "iat",
        "exp"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "aud": {
                "const": "urn:lobehub:gateway:agent"
              }
            },
            "required": [
              "aud"
            ]
          },
          "then": {
            "required": [
              "operation_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "aud": {
                "const": "urn:lobehub:gateway:device"
              }
            },
            "required": [
              "aud"
            ]
          },
          "then": {
            "required": [
              "device_id",
              "connection_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "aud": {
                "const": "urn:lobehub:gateway:agent"
              }
            },
            "required": [
              "aud"
            ]
          },
          "then": {
            "not": {
              "required": [
                "device_id"
              ]
            }
          }
        }
      ]
    },
    "identityResponse": {
      "type": "object",
      "properties": {
        "tenancyProtocol": {
          "const": 1
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "userId": {
          "type": "string",
          "minLength": 1
        },
        "principal": {
          "$ref": "#/$defs/principal"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "agent:observe",
              "agent:respond",
              "agent:execute",
              "device:connect",
              "device:respond"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "authorizationId": {
          "type": "string",
          "minLength": 1
        },
        "acceptedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "gatewayTicket": {
          "type": "string",
          "minLength": 1
        },
        "ticketExpiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authRecordExpiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "tenancyProtocol",
        "tenantId",
        "userId",
        "principal",
        "capabilities",
        "authorizationId",
        "acceptedVersion",
        "gatewayTicket",
        "ticketExpiresAt",
        "authRecordExpiresAt"
      ],
      "additionalProperties": false
    },
    "authFrame": {
      "type": "object",
      "properties": {
        "type": {
          "const": "auth"
        },
        "tenancyProtocol": {
          "const": 1
        },
        "tokenType": {
          "type": "string",
          "enum": [
            "jwt",
            "apiKey"
          ]
        },
        "token": {
          "type": "string",
          "minLength": 1
        },
        "serverUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "type",
        "tenancyProtocol",
        "tokenType",
        "token"
      ],
      "additionalProperties": false
    },
    "authSuccess": {
      "type": "object",
      "properties": {
        "type": {
          "const": "auth_success"
        },
        "tenancyProtocol": {
          "const": 1
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "principal": {
          "$ref": "#/$defs/principal"
        },
        "audience": {
          "type": "string",
          "enum": [
            "urn:lobehub:gateway:agent",
            "urn:lobehub:gateway:device"
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "agent:observe",
              "agent:respond",
              "agent:execute",
              "device:connect",
              "device:respond"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "acceptedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "connectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ticketExpiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authRecordExpiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "leaseExpiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "tenancyProtocol",
        "tenantId",
        "principal",
        "audience",
        "roles",
        "acceptedVersion",
        "connectionGeneration",
        "ticketExpiresAt",
        "authRecordExpiresAt",
        "leaseExpiresAt"
      ],
      "additionalProperties": false
    },
    "dispatchBinding": {
      "type": "object",
      "properties": {
        "connectionId": {
          "type": "string",
          "minLength": 1
        },
        "connectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authorizationId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "connectionId",
        "connectionGeneration",
        "authorizationId"
      ],
      "additionalProperties": false
    },
    "admissionRequest": {
      "type": "object",
      "properties": {
        "tenancyProtocol": {
          "const": 1
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        }
      },
      "required": [
        "tenancyProtocol",
        "tenantId"
      ],
      "additionalProperties": false
    },
    "admissionResponse": {
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "acceptedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "effectiveState": {
          "type": "string",
          "enum": [
            "active",
            "frozen",
            "offline",
            "expired",
            "unavailable"
          ]
        },
        "checkedAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "leaseExpiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "tenantId",
        "acceptedVersion",
        "effectiveState",
        "checkedAt",
        "leaseExpiresAt"
      ],
      "additionalProperties": false
    },
    "authorizeRequest": {
      "type": "object",
      "properties": {
        "tenancyProtocol": {
          "const": 1
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "authorizationId": {
          "type": "string",
          "minLength": 1
        },
        "ticket": {
          "type": "string",
          "minLength": 1
        },
        "expectedPrincipal": {
          "$ref": "#/$defs/principal"
        },
        "audience": {
          "type": "string",
          "enum": [
            "urn:lobehub:gateway:agent",
            "urn:lobehub:gateway:device"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "connect",
            "renew",
            "dispatch",
            "result"
          ]
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "sourceAcceptedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "dispatchBinding": {
          "$ref": "#/$defs/dispatchBinding"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requestSeq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "tenancyProtocol",
        "tenantId",
        "authorizationId",
        "expectedPrincipal",
        "audience",
        "action",
        "generation",
        "requestSeq"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "audience": {
                "const": "urn:lobehub:gateway:agent"
              }
            },
            "required": [
              "audience"
            ]
          },
          "then": {
            "required": [
              "operationId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "connect"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "ticket"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "renew"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "ticket"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "dispatch"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "sourceAcceptedVersion",
              "attemptId",
              "dispatchBinding"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "result"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "sourceAcceptedVersion",
              "attemptId",
              "dispatchBinding"
            ]
          }
        }
      ]
    },
    "authorizeResponse": {
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "authorizationId": {
          "type": "string",
          "minLength": 1
        },
        "principal": {
          "$ref": "#/$defs/principal"
        },
        "audience": {
          "type": "string",
          "enum": [
            "urn:lobehub:gateway:agent",
            "urn:lobehub:gateway:device"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "connect",
            "renew",
            "dispatch",
            "result"
          ]
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "acceptedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "ticketExpiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authRecordExpiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "leaseExpiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "checkedAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requestSeq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sourceAcceptedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "dispatchBinding": {
          "$ref": "#/$defs/dispatchBinding"
        }
      },
      "required": [
        "tenantId",
        "authorizationId",
        "principal",
        "audience",
        "action",
        "acceptedVersion",
        "ticketExpiresAt",
        "authRecordExpiresAt",
        "leaseExpiresAt",
        "checkedAt",
        "requestSeq",
        "generation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "audience": {
                "const": "urn:lobehub:gateway:agent"
              }
            },
            "required": [
              "audience"
            ]
          },
          "then": {
            "required": [
              "operationId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "dispatch"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "sourceAcceptedVersion",
              "attemptId",
              "dispatchBinding"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "result"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "sourceAcceptedVersion",
              "attemptId",
              "dispatchBinding"
            ]
          }
        }
      ]
    },
    "executionIntent": {
      "type": "object",
      "properties": {
        "tenancyProtocol": {
          "const": 1
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "sourceAcceptedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "actor": {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "sourceRef": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "subject",
            "sourceRef"
          ],
          "additionalProperties": false
        },
        "targetPrincipal": {
          "$ref": "#/$defs/principal"
        },
        "action": {
          "type": "string",
          "enum": [
            "operations.init",
            "operations.push-event",
            "operations.push-events",
            "operations.update-status",
            "operations.request-confirmation",
            "operations.request-input",
            "operations.tool-execute",
            "device.tool-call",
            "device.system-info",
            "device.rpc",
            "device.message-api",
            "device.agent/run"
          ]
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "toolCallId": {
          "type": "string",
          "minLength": 1
        },
        "resourceId": {
          "type": "string",
          "minLength": 1
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "attemptExpiresAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "tenancyProtocol",
        "tenantId",
        "sourceAcceptedVersion",
        "actor",
        "targetPrincipal",
        "action",
        "resourceId",
        "attemptId",
        "attemptExpiresAt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "operations.init"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "operationId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "operations.push-event"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "operationId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "operations.push-events"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "operationId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "operations.update-status"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "operationId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "operations.request-confirmation"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "operationId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "operations.request-input"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "operationId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "operations.tool-execute"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "operationId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "operations.tool-execute"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "operationId",
              "toolCallId"
            ]
          }
        }
      ]
    },
    "callback": {
      "type": "object",
      "properties": {
        "tenancyProtocol": {
          "const": 1
        },
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "sourceAcceptedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "toolCallId": {
          "type": "string",
          "minLength": 1
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "enum": [
            "cancelledBeforeDispatch",
            "interrupted",
            "executionUnknown",
            "completed"
          ]
        },
        "dispatchBinding": {
          "$ref": "#/$defs/dispatchBinding"
        },
        "result": {}
      },
      "required": [
        "tenancyProtocol",
        "tenantId",
        "sourceAcceptedVersion",
        "operationId",
        "toolCallId",
        "attemptId",
        "outcome",
        "dispatchBinding"
      ],
      "additionalProperties": false
    },
    "callbackAck": {
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "sourceAcceptedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "enum": [
            "cancelledBeforeDispatch",
            "interrupted",
            "executionUnknown",
            "completed",
            "finalized",
            "already_terminal",
            "still_running",
            "rejected"
          ]
        }
      },
      "required": [
        "tenantId",
        "sourceAcceptedVersion",
        "operationId",
        "outcome"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "cancelledBeforeDispatch",
                  "interrupted",
                  "executionUnknown",
                  "completed"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "attemptId"
            ]
          }
        }
      ]
    },
    "finalizeRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "tenancyProtocol": {
              "const": 1
            },
