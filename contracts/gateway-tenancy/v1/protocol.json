  "workRoutes": [
    {
      "method": "POST",
      "path": "<tenant-entry>/api/v1/gateway/identity",
      "authority": "existing-tenant-user-auth",
      "requestSchema": "identityRequest",
      "responseSchema": "identityResponse"
    },
    {
      "method": "POST",
      "path": "/api/internal/gateway/admission",
      "authority": "service",
      "requestSchema": "admissionRequest",
      "responseSchema": "admissionResponse"
    },
    {
      "method": "POST",
      "path": "/api/internal/gateway/authorize",
      "authority": "service",
      "requestSchema": "authorizeRequest",
      "responseSchema": "authorizeResponse"
    },
    {
      "method": "POST",
      "path": "/api/internal/gateway/tool-result",
      "authority": "service",
      "requestSchema": "callback",
      "responseSchema": "callbackAck"
    },
    {
      "method": "POST",
      "path": "/api/internal/gateway/finalize-abandoned",
      "authority": "service",
      "requestSchema": "finalizeRequest",
      "responseSchema": "callbackAck"
    }
  ],
  "disabledRoutes": [
    {
      "service": "agent",
      "method": "WS",
      "path": "/tenant/v1/v2/ws",
      "code": "MUX_UNSUPPORTED"
    },
    {
      "service": "agent",
      "method": "WS",
      "path": "/tenant/v1/admin/ws",
      "code": "ADMIN_OBSERVER_UNSUPPORTED"
    },
    {
      "service": "device",
      "method": "DELETE",
      "path": "/tenant/v1/api/admin/device",
      "code": "DEVICE_KICK_UNSUPPORTED"
    },
    {
      "service": "device",
      "method": "GET",
      "path": "/tenant/v1/api/device/metrics",
      "code": "DEVICE_METRICS_UNSUPPORTED"
    },
    {
      "service": "device",
      "method": "POST",
      "path": "/tenant/v1/api/device/metrics",
      "code": "DEVICE_METRICS_UNSUPPORTED"
    },
    {
      "service": "device",
      "method": "GET|POST|DELETE",
      "path": "/tenant/v1/api/admin/tunnels*",
      "code": "TUNNEL_UNSUPPORTED"
    }
  ],
  "messagePolicy": {
    "enabled": [
      "auth",
      "auth_success",
      "auth_failed",
      "auth_expired",
      "tenant_unavailable",
      "capability_failed",
      "lease_update",
      "heartbeat",
      "heartbeat_ack",
      "resume",
      "resume_complete",
      "agent_event",
      "status_change",
      "session_complete",
      "tool_execute",
      "tool_confirmation_request",
      "input_request",
      "tool_call_request",
      "system_info_request",
      "rpc_request",
      "message_api_request",
      "agent_run_request",
      "tool_result",
      "tool_confirmation",
      "user_input",
      "tool_call_response",
      "system_info_response",
      "rpc_response",
      "message_api_response",
      "agent_run_ack"
    ],
    "disabled": {
      "subscribe": "MUX_UNSUPPORTED",
      "llm_execute": "LLM_RELAY_UNSUPPORTED",
      "llm-execute": "LLM_RELAY_UNSUPPORTED",
      "llm-cancel": "LLM_RELAY_UNSUPPORTED",
      "llm-close": "LLM_RELAY_UNSUPPORTED",
      "tunnel_*": "TUNNEL_UNSUPPORTED",
      "device_metrics": "DEVICE_METRICS_UNSUPPORTED",
      "device_metrics_ack": "DEVICE_METRICS_UNSUPPORTED"
    },
    "note": "Only listed control/executable messages are supported. Existing agent_event payload types remain governed by the pinned upstream event schema; they cannot smuggle an executable command. Dispatch fields use dispatchCommand/dispatchResponse. Unlisted executable/control messages fail closed."
  }
}
