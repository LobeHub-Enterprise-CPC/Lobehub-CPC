{
  "contractVersion": 1,
  "tenancyPrefix": "/tenant/v1",
  "jwt": {
    "issuer": "urn:lobehub:gateway-session",
    "audiences": [
      "urn:lobehub:gateway:agent",
      "urn:lobehub:gateway:device"
    ],
    "purpose": "gateway-connect",
    "algorithm": "RS256",
    "maxLifetimeSeconds": 300
  },
  "time": {
    "wireUnit": "unix-milliseconds",
    "jwtUnit": "numeric-date-seconds",
    "maxLeaseMs": 30000,
    "deadlineOrigin": "request-start"
  },
  "capabilities": {
    "roles": [
      "agent:observe",
      "agent:respond",
      "agent:execute",
      "device:connect",
      "device:respond"
    ],
    "enabled": [
      "personal-device",
      "workspace-device",
      "device-tools-mcp-rpc-system-info",
      "device-agent-run",
      "single-operation-stream-replay",
      "agent-confirmation-input-client-tool",
      "desktop-message-api",
      "tenant-admin-history"
    ],
    "disabled": {
      "mux": "MUX_UNSUPPORTED",
      "llm-relay": "LLM_RELAY_UNSUPPORTED",
      "tunnel": "TUNNEL_UNSUPPORTED",
      "device-metrics": "DEVICE_METRICS_UNSUPPORTED",
      "admin-observer": "ADMIN_OBSERVER_UNSUPPORTED",
      "device-kick": "DEVICE_KICK_UNSUPPORTED",
      "share-visitor-gateway": "SHARE_GATEWAY_UNSUPPORTED"
    },
    "defaultError": "GATEWAY_CAPABILITY_UNSUPPORTED"
  },
  "executionActions": [
    "operations.init",
    "operations.push-event",
    "operations.push-events",
    "operations.update-status",
    "operations.request-confirmation",
    "operations.request-input",
    "operations.tool-execute",
    "device.tool-call",
    "device.system-info",
    "device.rpc",
    "device.message-api",
    "device.agent/run"
  ],
  "authorizeActions": [
    "connect",
    "renew",
    "dispatch",
    "result"
  ],
  "attemptOutcomes": [
    "cancelledBeforeDispatch",
    "interrupted",
    "executionUnknown",
    "completed"
  ],
  "routes": [
    {
      "service": "agent",
      "method": "WS",
      "path": "/tenant/v1/ws",
      "authority": "dedicated-ticket",
      "executionVersion": false
    },
    {
      "service": "device",
      "method": "WS",
      "path": "/tenant/v1/ws",
      "authority": "dedicated-ticket-or-identity-exchange",
      "executionVersion": false
    },
    {
      "service": "agent",
      "method": "GET",
      "path": "/tenant/v1/api/operations/status",
      "authority": "service",
      "executionVersion": false
    },
    {
      "service": "agent",
      "method": "POST",
      "path": "/tenant/v1/api/operations/init",
      "authority": "service",
      "executionVersion": true
    },
    {
      "service": "agent",
      "method": "POST",
      "path": "/tenant/v1/api/operations/push-event",
      "authority": "service",
      "executionVersion": true
    },
    {
      "service": "agent",
      "method": "POST",
      "path": "/tenant/v1/api/operations/push-events",
      "authority": "service",
      "executionVersion": true
    },
    {
      "service": "agent",
      "method": "POST",
      "path": "/tenant/v1/api/operations/update-status",
      "authority": "service",
      "executionVersion": true
    },
    {
      "service": "agent",
      "method": "POST",
      "path": "/tenant/v1/api/operations/request-confirmation",
      "authority": "service",
      "executionVersion": true
    },
    {
      "service": "agent",
      "method": "POST",
      "path": "/tenant/v1/api/operations/request-input",
      "authority": "service",
      "executionVersion": true
    },
    {
      "service": "agent",
      "method": "POST",
      "path": "/tenant/v1/api/operations/tool-execute",
      "authority": "service",
      "executionVersion": true
    },
    {
      "service": "device",
      "method": "GET",
      "path": "/tenant/v1/api/device/status",
      "authority": "service",
      "executionVersion": false
    },
    {
      "service": "device",
      "method": "GET",
      "path": "/tenant/v1/api/device/devices",
      "authority": "service",
      "executionVersion": false
    },
    {
      "service": "device",
      "method": "POST",
      "path": "/tenant/v1/api/device/tool-call",
      "authority": "service",
      "executionVersion": true
    },
    {
      "service": "device",
      "method": "POST",
      "path": "/tenant/v1/api/device/system-info",
      "authority": "service",
      "executionVersion": true
    },
    {
      "service": "device",
      "method": "POST",
      "path": "/tenant/v1/api/device/rpc",
      "authority": "service",
      "executionVersion": true
    },
    {
      "service": "device",
      "method": "POST",
      "path": "/tenant/v1/api/device/message-api",
      "authority": "service",
      "executionVersion": true
    },
    {
      "service": "device",
      "method": "POST",
      "path": "/tenant/v1/api/device/agent/run",
      "authority": "service",
      "executionVersion": true
    },
    {
      "service": "agent",
      "method": "GET",
      "path": "/tenant/v1/api/admin/stats",
      "authority": "admin",
      "executionVersion": false
    },
    {
      "service": "agent",
      "method": "GET",
      "path": "/tenant/v1/api/admin/metrics",
      "authority": "admin",
      "executionVersion": false
    },
    {
      "service": "agent",
      "method": "GET",
      "path": "/tenant/v1/api/admin/errors",
      "authority": "admin",
      "executionVersion": false
    },
    {
      "service": "agent",
      "method": "POST",
      "path": "/tenant/v1/api/control/tenant-suspend",
      "authority": "service",
      "executionVersion": "control-event"
    },
    {
      "service": "agent",
      "method": "GET",
      "path": "/tenant/v1/capabilities",
      "authority": "metadata-only",
      "executionVersion": false
    },
    {
      "service": "device",
      "method": "GET",
      "path": "/tenant/v1/api/admin/stats",
      "authority": "admin",
      "executionVersion": false
    },
    {
      "service": "device",
      "method": "GET",
      "path": "/tenant/v1/api/admin/metrics",
      "authority": "admin",
      "executionVersion": false
    },
    {
      "service": "device",
      "method": "POST",
      "path": "/tenant/v1/api/control/tenant-suspend",
      "authority": "service",
      "executionVersion": "control-event"
    },
    {
      "service": "device",
      "method": "GET",
      "path": "/tenant/v1/capabilities",
      "authority": "metadata-only",
      "executionVersion": false
    },
    {
      "service": "agent",
      "method": "DELETE",
      "path": "/tenant/v1/api/admin/errors",
      "authority": "admin",
      "executionVersion": false
    },
    {
      "service": "agent",
      "method": "DELETE",
      "path": "/tenant/v1/api/admin/errors/{errorId}",
      "authority": "admin",
      "executionVersion": false
    },
    {
      "service": "agent",
      "method": "POST",
      "path": "/tenant/v1/api/admin/errors/delete-batch",
      "authority": "admin",
      "executionVersion": false
    },
    {
      "service": "agent",
      "method": "POST",
      "path": "/tenant/v1/api/admin/reset-failure-count",
      "authority": "admin",
      "executionVersion": false
    }
  ],
  "errors": {
    "GATEWAY_TENANCY_REQUIRED": {
      "httpStatus": 426,
      "retryable": false,
      "wsEvent": "auth_failed",
      "wsClose": 1008
    },
    "GATEWAY_TENANCY_UNSUPPORTED": {
      "httpStatus": 426,
      "retryable": false,
      "wsEvent": "auth_failed",
      "wsClose": 1008
