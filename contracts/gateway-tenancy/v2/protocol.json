      "path": "/tenant/v1/api/device/rpc",
      "authority": "service",
      "executionVersion": true
    },
    {
      "service": "device",
      "method": "POST",
      "path": "/tenant/v1/api/device/message-api",
      "authority": "service",
      "executionVersion": true
    },
    {
      "service": "device",
      "method": "POST",
      "path": "/tenant/v1/api/device/agent/run",
      "authority": "service",
      "executionVersion": true
    },
    {
      "service": "agent",
      "method": "GET",
      "path": "/tenant/v1/api/admin/stats",
      "authority": "admin",
      "executionVersion": false
    },
    {
      "service": "agent",
      "method": "GET",
      "path": "/tenant/v1/api/admin/metrics",
      "authority": "admin",
      "executionVersion": false
    },
    {
      "service": "agent",
      "method": "GET",
      "path": "/tenant/v1/api/admin/errors",
      "authority": "admin",
      "executionVersion": false
    },
    {
      "service": "agent",
      "method": "POST",
      "path": "/tenant/v1/api/control/tenant-suspend",
      "authority": "service",
      "executionVersion": "control-event"
    },
    {
      "service": "agent",
      "method": "GET",
      "path": "/tenant/v1/capabilities",
      "authority": "metadata-only",
      "executionVersion": false
    },
    {
      "service": "device",
      "method": "GET",
      "path": "/tenant/v1/api/admin/stats",
      "authority": "admin",
      "executionVersion": false
    },
    {
      "service": "device",
      "method": "GET",
      "path": "/tenant/v1/api/admin/metrics",
      "authority": "admin",
      "executionVersion": false
    },
    {
      "service": "device",
      "method": "POST",
      "path": "/tenant/v1/api/control/tenant-suspend",
      "authority": "service",
      "executionVersion": "control-event"
    },
    {
      "service": "device",
