  "workRoutes": [
    {
      "method": "POST",
      "path": "<tenant-entry>/api/v1/gateway/identity",
      "authority": "existing-tenant-user-auth",
      "requestSchema": "identityRequest",
      "responseSchema": "identityResponse"
    },
    {
      "method": "POST",
      "path": "/api/internal/gateway/admission",
      "authority": "service",
      "requestSchema": "admissionRequest",
      "responseSchema": "admissionResponse"
    },
    {
      "method": "POST",
      "path": "/api/internal/gateway/authorize",
      "authority": "service",
      "requestSchema": "authorizeRequest",
      "responseSchema": "authorizeResponse"
    },
    {
      "method": "POST",
      "path": "/api/internal/gateway/tool-result",
      "authority": "service",
      "requestSchema": "callback",
      "responseSchema": "callbackAck"
    },
    {
      "method": "POST",
      "path": "/api/internal/gateway/finalize-abandoned",
      "authority": "service",
      "requestSchema": "finalizeRequest",
      "responseSchema": "callbackAck"
    }
  ],
  "disabledRoutes": [
    {
      "service": "agent",
      "method": "WS",
      "path": "/tenant/v1/admin/ws",
      "code": "ADMIN_OBSERVER_UNSUPPORTED"
    },
    {
      "service": "device",
      "method": "DELETE",
      "path": "/tenant/v1/api/admin/device",
      "code": "DEVICE_KICK_UNSUPPORTED"
    },
    {
      "service": "device",
      "method": "GET",
      "path": "/tenant/v1/api/device/metrics",
      "code": "DEVICE_METRICS_UNSUPPORTED"
    },
    {
      "service": "device",
      "method": "POST",
      "path": "/tenant/v1/api/device/metrics",
      "code": "DEVICE_METRICS_UNSUPPORTED"
    },
    {
      "service": "device",
      "method": "GET|POST|DELETE",
      "path": "/tenant/v1/api/admin/tunnels*",
      "code": "TUNNEL_UNSUPPORTED"
    }
  ],
  "messagePolicy": {
    "enabled": [
      "auth",
      "auth_success",
      "auth_failed",
      "auth_expired",
      "tenant_unavailable",
      "capability_failed",
      "lease_update",
      "heartbeat",
      "heartbeat_ack",
      "resume",
      "resume_complete",
      "agent_event",
      "status_change",
      "session_complete",
      "tool_execute",
      "tool_confirmation_request",
      "input_request",
      "tool_call_request",
      "system_info_request",
      "rpc_request",
      "message_api_request",
      "agent_run_request",
      "tool_result",
      "tool_confirmation",
      "user_input",
      "tool_call_response",
      "system_info_response",
      "rpc_response",
      "message_api_response",
      "agent_run_ack",
      "subscribe",
      "unsubscribe",
      "interrupt",
      "ready",
      "subscribe_failed",
      "op_lifecycle",
      "error"
    ],
    "disabled": {
      "llm_execute": "LLM_RELAY_UNSUPPORTED",
      "llm-execute": "LLM_RELAY_UNSUPPORTED",
      "llm-cancel": "LLM_RELAY_UNSUPPORTED",
      "llm-close": "LLM_RELAY_UNSUPPORTED",
      "tunnel_*": "TUNNEL_UNSUPPORTED",
      "device_metrics": "DEVICE_METRICS_UNSUPPORTED",
      "device_metrics_ack": "DEVICE_METRICS_UNSUPPORTED"
    },
    "note": "Only listed control/executable messages are supported. Existing agent_event payload types remain governed by the pinned upstream event schema; they cannot smuggle an executable command. Dispatch fields use dispatchCommand/dispatchResponse. Unlisted executable/control messages fail closed.",
    "muxOnlyStreamEventTypes": [
      "message_patch"
    ],
    "commandDelivery": {
      "routes": [
        "/tenant/v1/ws",
        "/tenant/v1/v2/ws"
      ],
      "pointToPoint": true,
      "buffered": false,
      "replayed": false
    }
  },
  "mux": {
    "wireTenancyProtocol": 1,
    "streamProtocol": 2,
    "firstFrameTimeoutMs": 3000,
    "routeTicketKinds": {
      "/tenant/v1/ws": "operation",
      "/tenant/v1/v2/ws": "user"
    },
    "subscribeAuthorization": {
      "action": "subscribe",
      "requestedRoles": "agent:observe plus agent:respond when held, plus agent:execute only when executor=true and held; every requested role must be within ticket capabilities",
      "ownership": "operation owner or stream owner in the same tenant; status does not matter",
      "source": "recheck original authorization source as connect (FR-GW-02)",
      "versionEquality": [
        "response.sourceAcceptedVersion",
        "ticket.accepted_version",
        "trustedInit.sourceAcceptedVersion"
      ],
      "denialReason": "forbidden",
      "denialCauses": [
        "unknown-operation",
        "foreign-tenant",
        "not-owner",
        "version-mismatch"
      ],
      "outage": {
        "frame": "error",
        "code": "GATEWAY_AUTHORITY_UNAVAILABLE",
        "retryable": true
      }
    },
    "executorUniqueness": "one live executor across both routes; mux contention grants without execute; same connection resubscribe retains execute",
    "settlement": "unsubscribe or close ends operation roles and settles claimed unsettled attempts as executionUnknown",
    "stamping": "all gateway frames: tenancyProtocol, tenantId, connectionGeneration; authorized operation frames additionally sourceAcceptedVersion; unauthorized subscribe_failed/error omit version; heartbeat_ack uses ticket accepted version"
  },
  "onlinePresence": {
    "tenantStats": {
      "required": [
        "onlineUsers",
        "onlineClients"
      ],
      "optional": [
        "connections.v1",
        "connections.v2"
      ]
    },
    "counting": "distinct users with a live agent socket per tenant across both routes; distinct live client connections",
    "platform": {
      "requiredHeaders": {
        "Authorization": "Bearer <ADMIN_TOKEN>",
        "X-LobeHub-Gateway-Tenancy": "1"
      },
      "forbiddenHeaders": {
        "X-LobeHub-Tenant-Id": "TENANT_INVALID"
      },
      "serviceTokenError": "FORBIDDEN",
      "responseHeaders": {
        "X-LobeHub-Gateway-Tenancy": "1"
      },
      "tenantHeaderEcho": false,
      "createsTenantState": false,
      "callsWork": false,
      "tenantOrder": "tenantId ascending",
      "include": "only tenants with a live socket",
      "totals": "sums over tenant list; tenants equals list length"
    }
  },
  "snapshot": {
    "formatVersion": 3,
    "layout": "one tenancy state file mapping tenant to immutable operation owner principal/sourceAcceptedVersion, plus one lower-gateway admin store file per tenant with path-safe encoded tenant id",
    "migration": "formatVersion 2 refused at startup; offline explicit idempotent command, original untouched, backup plus sha256",
    "persistsTicketsOrTokens": false
  }
}
