      "path": "/tenant/v1/api/admin/errors",
      "authority": "admin",
      "executionVersion": false
    },
    {
      "service": "agent",
      "method": "DELETE",
      "path": "/tenant/v1/api/admin/errors/{errorId}",
      "authority": "admin",
      "executionVersion": false
    },
    {
      "service": "agent",
      "method": "POST",
      "path": "/tenant/v1/api/admin/errors/delete-batch",
      "authority": "admin",
      "executionVersion": false
    },
    {
      "service": "agent",
      "method": "POST",
      "path": "/tenant/v1/api/admin/reset-failure-count",
      "authority": "admin",
      "executionVersion": false
    },
    {
      "service": "agent",
      "method": "GET",
      "path": "/tenant/v1/v2/ws",
      "authority": "ticket",
      "executionVersion": false,
      "upgrade": "websocket",
      "ticketKind": "user",
      "optionalQuery": {
        "clientId": "identity hint; must equal signed connection_id"
      }
    },
    {
      "service": "agent",
      "method": "GET",
      "path": "/tenant/v1/api/platform/online",
      "authority": "admin",
      "tenantScoped": false,
      "executionVersion": false,
      "responseSchema": "platformOnline",
      "requestSchema": "platformOnlineRequest"
    }
  ],
