      "schema": "platformOnline",
      "validation": "wire",
      "input": {
        "tenancyProtocol": 1,
        "generatedAt": 1900000000000,
        "tenants": [
          {
            "tenantId": "tenant-A",
            "onlineUsers": 1,
            "onlineClients": 2
          },
          {
            "tenantId": "tenant-B",
            "onlineUsers": 1,
            "onlineClients": 1
          }
        ],
        "totals": {
          "onlineUsers": 2,
          "onlineClients": 3,
          "tenants": 2
        }
      },
      "expected": {
        "accepted": true
      },
      "context": {
        "distinctUsersPerTenant": true,
        "bothRoutesCounted": true
      }
    },
