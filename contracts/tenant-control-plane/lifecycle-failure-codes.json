    "LIFECYCLE_FAILED": { "disposition": "retryable", "producers": ["admin", "lobehub"] },
    "LIFECYCLE_RESUME_FAILED": { "disposition": "retryable", "producers": ["lobehub"] },
    "LIFECYCLE_STATE_CHANGED": { "disposition": "retryable", "producers": ["admin"] },
    "LIFECYCLE_STOP_FAILED": { "disposition": "retryable", "producers": ["lobehub"] },
    "LIFECYCLE_STOP_UNCONFIRMED": { "disposition": "retryable", "producers": ["admin", "lobehub"] },
    "TENANT_NOT_READY": { "disposition": "retryable", "producers": ["admin", "lobehub"] }
  },
  "version": 1
}
